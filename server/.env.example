PORT=5000
# How many reverse proxies sit in front of the API. Unset or 0 leaves Express trust proxy off.
# TRUST_PROXY=1

# Requests per 15 minutes. When unset, production uses the first number and development uses the second.
# RATE_LIMIT_REGISTER=8
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_VERIFY_OTP=10
# RATE_LIMIT_RESEND_OTP=5
# RATE_LIMIT_FORGOT_PASSWORD=5
# RATE_LIMIT_RESET_PASSWORD=8
MONGODB_URI=mongodb://127.0.0.1:27017/renta
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# Required when NODE_ENV=production. In development, an empty value falls back to JWT_SECRET.
DOCUMENT_ENCRYPTION_KEY=

# Gmail OTP. Use a Google App Password, not the normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Local only: print the OTP in the server console when Gmail is not set. Never enable in production.
OTP_LOG_CODE=false

# PayMongo test keys from https://dashboard.paymongo.com
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Dev only. Refused when NODE_ENV=production. Opens a local Pay / Cancel page.
PAYMONGO_MOCK=false
